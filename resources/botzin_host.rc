CLASS "TBOTDLGK"
FONT 8, "MS Sans Serif", 0, 0, 1
BEGIN
    CONTROL "Hotkey type", 1001, "Button", 0x50000007, 2, 1, 332, 163, 0x00000000, 0
    CONTROL "The second is of type 'auto' : it will execute commands repeatedly every certain interval of time. The key you assign it to becomes a switch to toggle the repetitive execution on or off. Which type do you want this hotkey to be?", 1002, "Static", 0x50000000, 10, 64, 316, 28, 0x00000000, 0
    CONTROL "The action is only to be executed when the hotkey is pressed or is being held down", 1003, "Button", 0x50010009, 10, 97, 312, 8, 0x00000000, 0
